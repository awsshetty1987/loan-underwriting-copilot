{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDocuments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::loan-bucket2026",
      "Condition": {"StringLike": {"s3:prefix": ["loan-docs/*", "loan-policy/*"]}}
    },
    {
      "Sid": "ReadDocumentsAndRules",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::loan-bucket2026/loan-docs/*", "arn:aws:s3:::loan-bucket2026/loan-policy/*"]
    },
    {
      "Sid": "WriteAuditRecordsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::loan-bucket2026/loan-docs/*/audit/*"
    }
  ]
}
