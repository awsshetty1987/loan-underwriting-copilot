# Copy to .env for docker compose / local runs. Never commit .env.
# In AWS these come from Secrets Manager (see infra/ecs/task-definition.json).

# Where documents live: "local" (a folder) or "s3"
STORAGE_BACKEND=local
LOCAL_DATA_DIR=local_data
S3_BUCKET=loan-bucket2026
AWS_REGION=eu-north-1

# Keys the screen / bank systems send in the x-api-key header (comma-separated). Pick your own long random value.
API_KEYS=change-me-to-a-long-random-value

# Mock credit bureau
CREDIT_BUREAU_URL=http://127.0.0.1:9000/credit-report
CREDIT_BUREAU_API_KEY=change-me-too

# Optional: without it the payslip is read by plain code and the memo is written by plain code
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres for paused cases. Empty = in memory (lost on restart)
DATABASE_URL=

# Only needed if the screen is served from a different domain than the API
CORS_ORIGINS=
